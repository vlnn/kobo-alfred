				<key>type</key>
				<integer>0</integer>
				<key>script</key>
				<string>export PYTHONPATH="$PWD"
run() { nohup /usr/bin/python3 -m kobolib "$@" --notify &gt;/dev/null 2&gt;&amp;1 &amp; }
case "$action" in
  update) run update; echo "Rebuilding the index… a notification follows";;
  fix) run fix "$1"; echo "Fixing… a notification follows";;
  trash) run trash "$1"; echo "Moving to _trash/… a notification follows";;
  undo) run undo; echo "Undoing the last batch… a notification follows";;
  import) run import "$1"; echo "Importing… a notification follows";;
  genre) run genre "$book" "$1"; echo "Setting the genre… a notification follows";;
esac</string>
